# Copie ce fichier en fastlane/.env (git-ignoré) et renseigne tes valeurs.
# fastlane charge fastlane/.env automatiquement, pour les lanes comme pour les
# invocations directes (`fastlane deliver …`).
#
# Les trois valeurs viennent d'App Store Connect → Users and Access → Integrations
# → App Store Connect API. Le .p8 n'est téléchargeable qu'UNE fois.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/Users/toi/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
